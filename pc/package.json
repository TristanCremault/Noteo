{
  "name": "noteo",
  "version": "1.0.0",
  "description": "Application de bloc-notes locale",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "pdfkit": "^0.15.0",
    "jszip": "^3.10.1",
    "pdf-parse": "^1.1.1"
  },
  "build": {
    "appId": "com.tomwi.noteo",
    "productName": "Noteo",
    "files": [
      "**/*",
      "!fonds/**",
      "!fonds-defaut/**",
      "!build/**",
      "!installer/**",
      "!dist/**",
      "!*.md",
      "!*.bat"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    }
  }
}